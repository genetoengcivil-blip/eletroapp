{
  "rewrites": [
    { "source": "/((?!assets/|pwa-|sw\.js|workbox-|favicon\.ico|robots\.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
